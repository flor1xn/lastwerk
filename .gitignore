# Build und Abhaengigkeiten
/target/
node_modules/
__pycache__/
.venv/

# Tauri-Projekt der Oberflaeche (eigenes Cargo-Projekt, SPEC 5.2): Build-Ordner und vom
# Build erzeugte Schemata und Berechtigungen (build.rs schreibt sie bei jedem Build neu)
/app/src-tauri/target/
/app/src-tauri/gen/
/app/src-tauri/permissions/autogenerated/

# Private Daten: nichts unter local/ wird versioniert, ausser der README
/local/*
!/local/README.md

# Echte Aktivitaets- und Datenbankdateien nie committen
*.fit
*.FIT
*.db
*.db-wal
*.db-shm
*.sqlite

# Zugangsdaten
.env
.env.*
garmin_tokens.json

# Lokal gebaute Installer (scripts/build-installer.ps1), nie einchecken
/installer/

# Arbeitsbäume von Claude-Code-Agenten (lokal, nie einchecken)
/.claude/worktrees/
