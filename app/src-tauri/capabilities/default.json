{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimale Rechte des Hauptfensters (SPEC 10.4): nur die eigenen Befehle der App und das Hören auf Fortschrittsereignisse. Keine Shell, kein HTTP, kein Dateisystem- und kein Dialog-Plugin im Frontend. Die Dateiauswahl öffnet der Rust-Befehl add_fit_files. Das Anmeldefenster garmin-login (T23) steht hier nicht und hat damit keine Rechte.",
  "windows": ["main"],
  "permissions": [
    "allow-get-settings",
    "allow-set-settings",
    "allow-import-folder",
    "allow-add-fit-files",
    "allow-get-week-overview",
    "allow-get-dashboard",
    "allow-get-recovery",
    "allow-get-performance",
    "allow-get-progress",
    "allow-list-activities",
    "allow-get-activity",
    "allow-list-thresholds",
    "allow-set-threshold",
    "allow-set-athlete",
    "allow-list-plans",
    "allow-get-plan",
    "allow-generate-plan",
    "allow-set-plan-status",
    "allow-get-planning-inputs",
    "allow-set-goal",
    "allow-set-availability",
    "allow-export-plan-ics",
    "allow-export-plan-json",
    "allow-export-backup",
    "allow-restore-backup",
    "allow-check-update",
    "allow-get-bridge-status",
    "allow-install-update",
    "allow-garmin-status",
    "allow-garmin-login",
    "allow-garmin-sync",
    "allow-garmin-logout",
    "allow-quick-plan",
    "allow-coach-status",
    "allow-coach-set-model",
    "allow-coach-preview",
    "allow-coach-chat",
    "allow-coach-apply",
    "allow-coach-reset",
    "allow-coach-cancel",
    "allow-coach-setup-status",
    "allow-coach-install-ollama",
    "allow-coach-pull-model",
    "allow-coach-pull-cancel",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
