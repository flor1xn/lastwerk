{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan.schema.json",
  "title": "Lastwerk Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "created_at",
    "locale",
    "source",
    "rules_version",
    "goal",
    "weeks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plan_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "locale": {
      "enum": [
        "de",
        "en"
      ]
    },
    "source": {
      "enum": [
        "rules",
        "llm"
      ]
    },
    "rules_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "goal": {
      "$ref": "#/$defs/goal"
    },
    "weeks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 26,
      "items": {
        "$ref": "#/$defs/week"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    },
    "explanation": {
      "type": "string",
      "maxLength": 1200
    }
  },
  "$defs": {
    "sport": {
      "enum": [
        "cycling",
        "running",
        "swimming",
        "strength",
        "rest"
      ]
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "event",
            "continuous"
          ]
        },
        "event_date": {
          "type": "string",
          "format": "date"
        },
        "sport": {
          "$ref": "#/$defs/sport"
        },
        "priority": {
          "enum": [
            "A",
            "B",
            "C"
          ]
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "event"
          }
        }
      },
      "then": {
        "required": [
          "event_date"
        ]
      }
    },
    "week": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "week_start",
        "phase",
        "target_load",
        "days"
      ],
      "properties": {
        "week_start": {
          "type": "string",
          "format": "date"
        },
        "phase": {
          "enum": [
            "base",
            "build",
            "peak",
            "taper",
            "recovery",
            "race"
          ]
        },
        "target_load": {
          "type": "number",
          "minimum": 0
        },
        "planned_load": {
          "type": "number",
          "minimum": 0
        },
        "reason_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_.]+$"
          }
        },
        "days": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "$ref": "#/$defs/day"
          }
        }
      }
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "sessions"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "sessions": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/session"
          }
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "sport",
        "template_id",
        "duration_min",
        "planned_load",
        "hard"
      ],
      "properties": {
        "slot": {
          "enum": [
            "am",
            "pm"
          ]
        },
        "sport": {
          "$ref": "#/$defs/sport"
        },
        "template_id": {
          "type": "string",
          "pattern": "^[a-z]+(\\.[a-z0-9_]+)+$"
        },
        "duration_min": {
          "type": "integer",
          "minimum": 10,
          "maximum": 360
        },
        "planned_load": {
          "type": "number",
          "minimum": 0
        },
        "hard": {
          "type": "boolean"
        },
        "rpe": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "reason_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_.]+$"
          }
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z]{1,3}[0-9]{2}$"
        },
        "severity": {
          "enum": [
            "info",
            "warn"
          ]
        },
        "date": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
